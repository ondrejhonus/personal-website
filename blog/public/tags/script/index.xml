      <title>Linux scheduled backup with CRON</title>
      <link>http://localhost:1313/documents/scheduled-backup/</link>
      <pubDate>Thu, 19 Mar 2026 10:30:59 +0000</pubDate>
      <guid>http://localhost:1313/documents/scheduled-backup/</guid>
      <description>&lt;h2 id=&#34;python-script-to-backup&#34;&gt;Python script to backup&lt;/h2&gt;&#xA;&lt;blockquote&gt;&#xA;&lt;p&gt;backup.py&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-python&#34; data-lang=&#34;python&#34;&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/blockquote&gt;&#xA;&lt;p&gt;import sys, subprocess, os&lt;/p&gt;&#xA;&lt;p&gt;if len(sys.argv) != 2:&#xA;print(&amp;ldquo;No destination file provided&amp;rdquo;)&#xA;sys.exit(1)&lt;/p&gt;&#xA;&lt;p&gt;source = &amp;ldquo;/home/u1/Plocha/&amp;rdquo;&#xA;target = sys.argv[1]&lt;/p&gt;&#xA;&lt;p&gt;result = subprocess.run([&amp;ldquo;rsync&amp;rdquo;, &amp;ldquo;-avpo&amp;rdquo;, source, target])&lt;/p&gt;&#xA;&lt;p&gt;if result.returncode == 0:&#xA;print(&amp;ldquo;Rsync backup was successful&amp;rdquo;)&#xA;sys.exit(0)&#xA;else:&#xA;print(&amp;ldquo;Error while backing up&amp;rdquo;, result.returncode)&#xA;sys.exit(1)&lt;/p&gt;&#xA;&lt;blockquote&gt;&#xA;&lt;pre tabindex=&#34;0&#34;&gt;&lt;code&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/blockquote&gt;</description>
