    <item>
      <title>In-Browser Metronome</title>
      <link>http://localhost:1313/projects/metronome/</link>
      <pubDate>Fri, 23 Jan 2026 23:00:00 +0000</pubDate><author>ondrejhonus@pm.me (Ondřej Honus)</author>
      <guid>http://localhost:1313/projects/metronome/</guid>
      <description>&lt;link rel=&#34;stylesheet&#34; href=&#34;http://localhost:1313/css/minigame-styles.css&#34;&gt;&#xA;&#xA;&lt;div class=&#34;box-mg&#34;&gt;&#xA;  &lt;form onsubmit=&#34;window.toggleMetronome(); return false;&#34;&#xA;    class=&#34;flex flex-col items-center gap-4&#34;&gt;&#xA;    &lt;div&gt;&#xA;&#xA;      &lt;input type=&#34;number&#34; id=&#34;bpmInput&#34;&#xA;        class=&#34;input-mg&#34;&#xA;        placeholder=&#34;BPM&#34; min=&#34;20&#34; max=&#34;500&#34; value=&#34;120&#34; required&gt;&#xA;      &lt;span class=&#34;ml-2 text-lg font-bold&#34;&gt;BPM&lt;/span&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;button type=&#34;submit&#34;&#xA;      class=&#34;button-mg&#34;&gt;&#xA;      Toggle&#xA;    &lt;/button&gt;&#xA;  &lt;/form&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;script src=&#34;http://localhost:1313/%20js/metronome.js&#34;&gt;&lt;/script&gt;&#xA;&lt;p&gt;This is a simple metronome that runs directly on this page. You can set the tempo in beats per minute (BPM) using the input field above, and start or stop the metronome using the button.&lt;/p&gt;</description>
    </item>
