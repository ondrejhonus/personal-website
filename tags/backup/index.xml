<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Backup on Ondřej Honus' website</title><link>https://ondrejhonus.com/tags/backup/</link><description>Recent content in Backup on Ondřej Honus' website</description><generator>Hugo</generator><language>en-us</language><lastBuildDate>Fri, 20 Mar 2026 11:30:59 +0000</lastBuildDate><atom:link href="https://ondrejhonus.com/tags/backup/index.xml" rel="self" type="application/rss+xml"/><item><title>Rsync /home to drive</title><link>https://ondrejhonus.com/snippets/rsync-home/</link><pubDate>Fri, 20 Mar 2026 11:30:59 +0000</pubDate><guid>https://ondrejhonus.com/snippets/rsync-home/</guid><description>&lt;p&gt;Save exclude files to /var/tmp/ignorelist:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-sh" data-lang="sh"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;wget https://raw.githubusercontent.com/rubo77/rsync-homedir-excludes/master/rsync-homedir-excludes.txt -O /var/tmp/ignorelist
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;blockquote&gt;
&lt;p&gt;You have to mount your drive to /media/&lt;!-- raw HTML omitted --&gt;/homebackup !&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p&gt;Rsync home folder to /media/&lt;!-- raw HTML omitted --&gt;/backup:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-sh" data-lang="sh"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;sudo rsync -aP --exclude-from&lt;span style="color:#f92672"&gt;=&lt;/span&gt;/var/tmp/ignorelist /home/$USER/ /media/$USER/homebackup
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description></item></channel></rss>